{
    "type": "viewScreen",
    "id": "bluetooth",
    "mountMode": "dynamic",
    "commonProps": {
        "scrollable": false
    },
    "styleRefs": [
        "app.page"
    ],
    "children": [
        {
            "type": "container",
            "id": "page",
            "commonProps": {
                "scrollable": true
            },
            "layout": {
                "type": "flex",
                "flexFlow": "column",
                "gap": "${constant.settings.layout.pageGap}"
            },
            "placement": {
                "mode": "absolute",
                "x": "${constant.settings.layout.pageX}",
                "y": "${constant.settings.layout.pageY}",
                "width": "${constant.settings.layout.pageWidth}",
                "height": "${constant.settings.layout.pageHeight}"
            },
            "children": [
                {
                    "type": "container",
                    "id": "phone_provisioning",
                    "styleRefs": [
                        "app.card"
                    ],
                    "style": {
                        "padding": 16
                    },
                    "commonProps": {
                        "scrollable": false
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "column",
                        "gap": 8
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": 222,
                        "alignSelf": "stretch"
                    },
                    "children": [
                        {
                            "type": "label",
                            "id": "title",
                            "style": {
                                "font": "${font.zh_CN}",
                                "fontSize": 24,
                                "textColor": "#edf5ff"
                            },
                            "labelProps": {
                                "text": "蓝牙遥控"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "match",
                                "height": 30
                            }
                        },
                        {
                            "type": "label",
                            "id": "status",
                            "bindings": {
                                "labelProps.text": "text"
                            },
                            "style": {
                                "font": "${font.zh_CN}",
                                "fontSize": 20,
                                "textColor": "#c6d5e8"
                            },
                            "labelProps": {
                                "text": "开启后在手机小马遥控中连接"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "match",
                                "height": 98
                            }
                        },
                        {
                            "type": "button",
                            "id": "remote",
                            "placement": {
                                "mode": "flow",
                                "width": "match",
                                "height": 44
                            },
                            "style": {
                                "radius": 12,
                                "padding": 0,
                                "bgColor": "#24516b"
                            },
                            "layout": {
                                "type": "flex",
                                "mainAlign": "center",
                                "crossAlign": "center"
                            },
                            "events": [
                                {
                                    "type": "clicked",
                                    "action": "settings.wifi.phone_remote"
                                }
                            ],
                            "children": [
                                {
                                    "type": "label",
                                    "id": "label",
                                    "bindings": {
                                        "labelProps.text": "text"
                                    },
                                    "style": {
                                        "font": "${font.zh_CN}",
                                        "fontSize": 22,
                                        "textColor": "#ffffff"
                                    },
                                    "labelProps": {
                                        "text": "开启蓝牙遥控"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
