{
  "type": "viewTemplate",
  "id": "file_entry",
  "node": {
    "type": "button",
    "commonProps": {
      "hidden": true,
      "pressLock": false
    },
    "bindings": {
      "commonProps.hidden": "commonProps.hidden"
    },
    "styleRefs": [
      "app.listItem"
    ],
    "style": {
      "padding": "0dp"
    },
    "events": [
      {
        "type": "clicked",
        "action": "files.entry.click"
      },
      {
        "type": "longPressed",
        "action": "files.entry.long"
      }
    ],
    "layout": {
      "type": "none"
    },
    "placement": {
      "mode": "flow",
      "width": "match",
      "height": 64,
      "alignSelf": "stretch"
    },
    "children": [
      {
        "type": "container",
        "id": "body",
        "commonProps": {
          "clickable": false
        },
        "layout": {
          "type": "grid",
          "gridTemplateColumns": [
            "${constant.files.layout.iconColumn}",
            "match"
          ],
          "gridTemplateRows": [
            "match"
          ],
          "gap": "10dp",
          "crossAlign": "center"
        },
        "placement": {
          "mode": "relative",
          "align": "center",
          "width": "match",
          "height": "match"
        },
        "children": [
          {
            "type": "image",
            "id": "icon",
            "commonProps": {
              "clickable": false
            },
            "bindings": {
              "imageProps.src": "imageProps.src"
            },
            "placement": {
              "mode": "flow",
              "gridColumn": 0,
              "gridRow": 0,
              "width": "${constant.files.layout.iconBox}",
              "height": "${constant.files.layout.iconBox}",
              "alignSelf": "center"
            },
            "imageProps": {
              "src": "${image.files.icon.file}",
              "innerAlign": "contain"
            },
            "style": {
              "bgColor": "#16221A",
              "radius": 8,
              "padding": 2
            }
          },
          {
            "type": "container",
            "id": "content",
            "commonProps": {
              "clickable": false
            },
            "layout": {
              "type": "flex",
              "flexFlow": "column",
              "mainAlign": "center",
              "crossAlign": "start",
              "gap": "3dp"
            },
            "placement": {
              "mode": "flow",
              "gridColumn": 1,
              "gridRow": 0,
              "alignSelf": "stretch"
            },
            "children": [
              {
                "type": "label",
                "id": "title",
                "bindings": {
                  "labelProps.text": "labelProps.text"
                },
                "style": {
                  "fontSize": 19,
                  "textColor": "#F3F6ED"
                },
                "labelProps": {
                  "text": ""
                }
              },
              {
                "type": "label",
                "id": "detail",
                "bindings": {
                  "labelProps.text": "labelProps.text"
                },
                "style": {
                  "fontSize": 15,
                  "textColor": "#A7B2A9"
                },
                "labelProps": {
                  "text": ""
                }
              }
            ]
          }
        ],
        "style": {
          "bgColor": "#1B271F",
          "borderColor": "#304036",
          "borderWidth": 1,
          "radius": 10
        },
        "bindings": {
          "style.bgColor": "style.bgColor"
        }
      }
    ]
  }
}
