{
  "type": "viewScreen",
  "id": "files_header",
  "commonProps": {
    "clickable": false,
    "scrollable": false
  },
  "children": [
    {
      "type": "container",
      "id": "bar",
      "commonProps": {
        "scrollable": false
      },
      "style": {
        "padding": 0
      },
      "layout": {
        "type": "grid",
        "gridTemplateColumns": [
          46,
          "match",
          120
        ],
        "gridTemplateRows": [
          "match"
        ],
        "gap": "10dp",
        "crossAlign": "center"
      },
      "placement": {
        "mode": "absolute",
        "x": 24,
        "y": 10,
        "width": 432,
        "height": 66
      },
      "children": [
        {
          "type": "button",
          "id": "back",
          "events": [
            {
              "type": "clicked",
              "action": "files.back"
            }
          ],
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "placement": {
            "mode": "flow",
            "gridColumn": 0,
            "gridRow": 0,
            "width": 46,
            "height": 46,
            "alignSelf": "center"
          },
          "children": [
            {
              "type": "label",
              "id": "label",
              "labelProps": {
                "text": "<"
              },
              "style": {
                "fontSize": 24,
                "textColor": "#F3F6ED",
                "textAlign": "center"
              }
            }
          ],
          "style": {
            "bgColor": "#1B271F",
            "borderColor": "#304036",
            "borderWidth": 1,
            "radius": 12,
            "padding": 0
          }
        },
        {
          "type": "container",
          "id": "text",
          "commonProps": {
            "clickable": false,
            "scrollable": false
          },
          "layout": {
            "type": "flex",
            "flexFlow": "column",
            "mainAlign": "center",
            "crossAlign": "start",
            "gap": "3dp"
          },
          "placement": {
            "mode": "flow",
            "gridColumn": 1,
            "gridRow": 0,
            "alignSelf": "stretch"
          },
          "children": [
            {
              "type": "label",
              "id": "title",
              "bindings": {
                "labelProps.text": "labelProps.text"
              },
              "style": {
                "fontSize": 26,
                "textColor": "#F3F6ED"
              },
              "labelProps": {
                "text": "${constant.files.i18n.storage}"
              }
            },
            {
              "type": "label",
              "id": "subtitle",
              "bindings": {
                "labelProps.text": "labelProps.text"
              },
              "labelProps": {
                "text": "${constant.files.i18n.volumes_subtitle}"
              },
              "style": {
                "fontSize": 15,
                "textColor": "#A7B2A9"
              }
            }
          ]
        },
        {
          "type": "container",
          "id": "count",
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "placement": {
            "mode": "flow",
            "gridColumn": 2,
            "gridRow": 0,
            "width": 120,
            "height": 40,
            "alignSelf": "center"
          },
          "children": [
            {
              "type": "label",
              "id": "label",
              "bindings": {
                "labelProps.text": "labelProps.text"
              },
              "labelProps": {
                "text": "${constant.files.i18n.empty}"
              },
              "style": {
                "fontSize": 15,
                "textColor": "#A7B2A9"
              }
            }
          ],
          "style": {
            "bgColor": "#1B271F",
            "borderColor": "#304036",
            "borderWidth": 1,
            "radius": 12,
            "padding": 0
          }
        }
      ]
    }
  ]
}
