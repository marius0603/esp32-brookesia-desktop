CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BROOKESIA_SERVICE_USB_TRANSPORT_SERIAL_JTAG=y
CONFIG_BROOKESIA_SERVICE_USB_ENABLE_AUTO_REGISTER=y
CONFIG_BROOKESIA_SYSTEM_CORE_ENABLE_USB_BRIDGE=y
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_ENABLE_PROCESSOR_IMPL=n
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_ENABLE_CODEC_RECORDER_IMPL=y
CONFIG_ESP_TLS_INSECURE=n
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_SPIRAM_RODATA=n
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=n
CONFIG_SPIRAM_XIP_FROM_PSRAM=n
CONFIG_BROOKESIA_SERVICE_MANAGER_SECONDARY_SCHEDULER_ENABLE=y
CONFIG_BROOKESIA_SERVICE_MANAGER_WORKER_STACK_IN_EXT=n
CONFIG_BROOKESIA_SYSTEM_SUPER_ENABLE_RESOURCE_FONT_COPY=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FREETYPE=y
CONFIG_LV_USE_FREETYPE=y
CONFIG_LV_FREETYPE_USE_LVGL_PORT=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_LV_CACHE_DEF_SIZE=1048576
CONFIG_BROOKESIA_GUI_LVGL_DISPLAY_SOURCE_BUFFER_HEIGHT=32
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_XIAOZHI_INFO_TIMEOUT_MS=15000
CONFIG_XIAOZHI_STACK_IN_PSRAM=n
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_BROOKESIA_GUI_LVGL_DISPLAY_SOURCE_TASK_MAX_DELAY_MS=20

# Fast, cached RGB565 wallpaper
CONFIG_LV_USE_RLE=y

CONFIG_MODEL_IN_SDCARD=y
# CONFIG_MODEL_IN_FLASH is not set
