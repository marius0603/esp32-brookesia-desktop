+static void bind_settings_touch(Record &record, const std::vector<EventBinding> &events)
+{
+    if (record.settings_touch) {
+        if (record.settings_touch->temporary_press_lock) {
+            lv_obj_remove_flag(record.object, LV_OBJ_FLAG_PRESS_LOCK);
+        }
+        lv_obj_remove_event_cb_with_user_data(record.object, on_settings_touch, record.settings_touch.get());
+        record.settings_touch.reset();
+    }
+    if (!std::any_of(events.begin(), events.end(), [](const EventBinding &event) {
+        return event.action.starts_with("settings.");
+    })) {
+        return;
+    }
+    record.settings_touch = std::make_unique<SettingsTouchGesture>();
+    for (const auto code : {LV_EVENT_PRESSED, LV_EVENT_PRESSING, LV_EVENT_PRESS_LOST,
+                            LV_EVENT_RELEASED, LV_EVENT_CLICKED}) {
+        lv_obj_add_event_cb(record.object, on_settings_touch,
+                            static_cast<lv_event_code_t>(code | LV_EVENT_PREPROCESS), record.settings_touch.get());
+    }
+}
