+AppStoreApp::~AppStoreApp()
+{
+    close_app_callbacks();
+}
+
+void AppStoreApp::close_app_callbacks()
+{
+    if (!callback_queue_) {
+        return;
+    }
+    std::vector<AsyncWork> pending;
+    {
+        std::lock_guard lock(callback_queue_->mutex);
+        callback_queue_->active = false;
+        pending.swap(callback_queue_->jobs);
+    }
+    // Late accepted HTTP requests must still be canceled, without accessing
+    // AppStoreApp or its AppContext from the service worker.
+    for (auto &job : pending) {
+        if (job.discard) {
+            job.discard();
+        }
+    }
+}
+
+void AppStoreApp::poll_app_callbacks()
+{
+    std::vector<AsyncWork> pending;
+    {
+        std::lock_guard lock(callback_queue_->mutex);
+        pending.swap(callback_queue_->jobs);
+    }
+    for (auto &job : pending) {
+        job.run();
+    }
+}
 
