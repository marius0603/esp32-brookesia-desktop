+    // Service and GUI threads only enqueue owned values. App timers drain these
+    // jobs in the same execution domain as on_start/on_stop. Each launch gets
+    // a new scope, so late completions cannot access a closed or reopened app.
+    struct AsyncWork {
+        std::function<void()> run;
+        std::function<void()> discard;
+    };
+    struct CallbackQueue {
+        std::mutex mutex;
+        bool active = true;
+        std::vector<AsyncWork> jobs;
+    };
+    std::shared_ptr<CallbackQueue> callback_queue_;
+    void close_app_callbacks();
+    void poll_app_callbacks();
+
+    template<class... Args, class Fn, class Drop = std::nullptr_t>
+    std::function<void(Args...)> app_callback(Fn fn, Drop drop = nullptr)
+    {
+        auto queue = callback_queue_;
+        return [queue, fn = std::move(fn), drop = std::move(drop)](Args... args) mutable {
+            auto values = std::make_shared<std::tuple<std::decay_t<Args>...>>(std::forward<Args>(args)...);
+            AsyncWork work;
+            work.run = [fn, values]() mutable { std::apply(fn, std::move(*values)); };
+            if constexpr (!std::is_same_v<Drop, std::nullptr_t>) {
+                work.discard = [drop, values]() mutable { std::apply(drop, std::move(*values)); };
+            }
+            if (queue) {
+                std::lock_guard lock(queue->mutex);
+                if (queue->active) {
+                    queue->jobs.push_back(std::move(work));
+                    return;
+                }
+            }
+            if (work.discard) {
+                work.discard();
+            }
+        };
+    }
