+bool LcdDisplayPanelImpl::draw_staged_locked(uint32_t x1,uint32_t y1,uint32_t x2,uint32_t y2,const uint8_t *data,uint32_t timeout_ms)
+{
+    if (!is_valid_internal() || !data || x2<=x1 || y2<=y1 || x2>get_info().h_res || y2>get_info().v_res) return false;
+    if (!event_dispatcher_enabled_ && !enable_event_dispatcher_locked()) return false;
+    const size_t row_bytes=(x2-x1)*2;
+    const uint32_t rows=3840/row_bytes;
+    if (!rows) return false;
+    const TickType_t started=xTaskGetTickCount(),budget=std::max<TickType_t>(1,pdMS_TO_TICKS(timeout_ms));
+    bool ok=true;
+    for (uint32_t y=y1;y<y2;) {
+        const auto count=std::min(rows,y2-y);
+        while(xSemaphoreTake(sync_done_,0)==pdTRUE) {}
+        memcpy(dma_stage_,data+size_t(y-y1)*row_bytes,size_t(count)*row_bytes);
+        portENTER_CRITICAL(&event_lock_);
+        suppress_strip_events_=y+count<y2;
+        sync_waiting_=true;sync_target_draw_seq_=submitted_draw_seq_+1;
+        portEXIT_CRITICAL(&event_lock_);
+        const auto elapsed=xTaskGetTickCount()-started;
+        if (elapsed>=budget || !submit_draw_bitmap_locked(x1,y,x2,y+count,dma_stage_) ||
+            xSemaphoreTake(sync_done_,budget-elapsed)!=pdTRUE) {ok=false;break;}
+        y+=count;
+    }
+    // Never recycle or free the fixed staging memory while DMA still owns it.
+    if (!ok) drain_spi_transfers_locked();
+    portENTER_CRITICAL(&event_lock_);
+    sync_waiting_=false;sync_target_draw_seq_=0;suppress_strip_events_=false;
+    portEXIT_CRITICAL(&event_lock_);
+    return ok;
 }
 
