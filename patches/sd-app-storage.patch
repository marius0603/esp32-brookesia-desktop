new file mode 100644
--- /dev/null
+++ b/system/brookesia_system_core/src/private/app/storage_transaction.hpp
@@ -0,0 +1,117 @@
+#pragma once
+#include <filesystem>
+#include <expected>
+#include <string>
+#include <vector>
+#include "boost/json.hpp"
+#include "brookesia/service_helper/system/storage.hpp"
+#include "brookesia/system_core/app/package.hpp"
+#include "brookesia/service_manager/service/manager.hpp"
+
+extern "C" bool brookesia_board_runtime_requires_sd(const char *) __attribute__((weak));
+extern "C" bool brookesia_child_requires_internal(const char *) __attribute__((weak));
+namespace esp_brookesia::system::core::install_storage {
+namespace fs=std::filesystem;
+using Storage=esp_brookesia::service::helper::Storage;
+inline constexpr uint32_t timeout=15000;
+inline bool requires_sd(const std::string &id){return brookesia_board_runtime_requires_sd && brookesia_board_runtime_requires_sd(id.c_str());}
+inline std::expected<bool,std::string> present(const fs::path &p){auto v=Storage::fs_stat(p.generic_string(),timeout);if(!v)return std::unexpected(v.error());return v->exists;}
+inline std::expected<void,std::string> erase_tree(const fs::path &p){auto e=present(p);if(!e)return std::unexpected(e.error());if(!*e)return {};return Storage::fs_remove(p.generic_string(),timeout);}
+inline std::expected<void,std::string> mkdir(const fs::path &p){return Storage::fs_mkdir(p.generic_string(),timeout);}
+inline std::expected<void,std::string> move_tree(const fs::path &a,const fs::path &b){return Storage::fs_rename(a.generic_string(),b.generic_string(),timeout);}
+inline std::expected<void,std::string> copy_tree(const fs::path &a,const fs::path &b){return Storage::fs_copy_tree(a.generic_string(),b.generic_string(),true,timeout);}
+inline std::expected<uint64_t,std::string> allocated_tree(const fs::path &p,uint32_t unit=4096){
+ auto stat=Storage::fs_stat(p.generic_string(),timeout);if(!stat)return std::unexpected(stat.error());if(!stat->exists)return uint64_t(0);
+ if(stat->type==Storage::FileType::File)return ((uint64_t(stat->size)+unit-1)/unit)*unit;
+ if(stat->type!=Storage::FileType::Directory)return std::unexpected("Unsupported storage entry");
+ auto entries=Storage::fs_list(p.generic_string(),timeout);if(!entries)return std::unexpected(entries.error());uint64_t total=unit;
+ for(const auto &e:*entries){auto n=allocated_tree(p/e.name,unit);if(!n)return std::unexpected(n.error());total+=*n;}return total;
+}
+inline std::expected<void,std::string> check_space(const std::string &mount,uint64_t required){
+ auto cap=Storage::call_function_sync<boost::json::object>(Storage::FunctionId::GetFileSystemCapacity,mount);
+ if(!cap)return std::unexpected("Cannot inspect installation volume: "+cap.error());
+ auto *v=cap->if_contains("free_bytes");if(!v||!v->is_number())return std::unexpected("Missing free-space information");
+ uint64_t free=boost::json::value_to<uint64_t>(*v);
+ if(free<required)return std::unexpected("Insufficient install space: need "+std::to_string(required)+" bytes including unpacked files, private data and reserve; free "+std::to_string(free));
+ return {};
+}
+inline std::expected<std::string,std::string> tree_digest(const fs::path &path){
+ auto binding=esp_brookesia::service::ServiceManager::get_instance().bind("SdResources");
+ auto service=binding.get_service();
+ if(!binding.is_valid()||!service)return std::unexpected("App integrity service is unavailable");
+ auto value=service->call_function_sync("InspectTree",boost::json::object{{"Path",path.generic_string()}},30000);
+ if(!value.success||!value.data)return std::unexpected("Cannot inspect copied app: "+value.error_message);
+ auto object=std::get_if<boost::json::object>(&*value.data);if(!object)return std::unexpected("Invalid tree checksum response");
+ auto *hash=object->if_contains("sha256");if(!hash||!hash->is_string())return std::unexpected("Missing tree checksum");return std::string(hash->as_string());
+}
+inline std::expected<void,std::string> verify_copy(const fs::path &a,const fs::path &b){
+ auto left=tree_digest(a);if(!left)return std::unexpected(left.error());auto right=tree_digest(b);if(!right)return std::unexpected(right.error());
+ if(*left!=*right)return std::unexpected("Application copy checksum mismatch");
+ return {};
+}
+struct Transaction {
+ std::string id,nonce;fs::path root,old,final,backup,stage;
+ fs::path marker()const{return root/".transactions"/(id+".json");}
+ fs::path commit_marker()const{return root/".transactions"/(id+".committed");}
+ fs::path restore_marker()const{return root/".transactions"/(id+".restoring");}
+ boost::json::object json()const{return {{"schema",1},{"id",id},{"nonce",nonce},{"old",old.generic_string()},{"final",final.generic_string()},{"backup",backup.generic_string()},{"stage",stage.generic_string()}};}
+ std::expected<void,std::string> begin()const{
+  auto e=present(marker());if(!e)return std::unexpected(e.error());if(*e)return std::unexpected("Previous install needs recovery; restart before retrying");
+  auto m=mkdir(marker().parent_path());if(!m)return m;
+  return Storage::fs_write_text(marker().generic_string(),boost::json::serialize(json()),timeout);
+ }
+ std::expected<void,std::string> commit()const{
+  return Storage::fs_write_text(commit_marker().generic_string(),boost::json::serialize(boost::json::object{{"nonce",nonce}}),timeout);
+ }
+ std::expected<void,std::string> clear()const{
+  auto r=erase_tree(marker());if(!r)return r;r=erase_tree(commit_marker());if(!r)return r;return erase_tree(restore_marker());
+ }
+ std::expected<void,std::string> rollback()const{
+  // Before the old directory is renamed, its backup does not exist. Never
+  // remove the still-current directory in that power-loss window.
+  auto backed=present(backup);if(!backed)return std::unexpected(backed.error());
+  if(old==final && !*backed)return {};
+  auto r=erase_tree(final);if(!r)return r;
+  if(old.empty())return {};
+  auto exists=present(old);if(!exists)return std::unexpected(exists.error());
+  bool restoring=false;auto pending=present(restore_marker());if(!pending)return std::unexpected(pending.error());
+  if(*pending){auto value=Storage::fs_read_text(restore_marker().generic_string(),timeout);if(value){boost::system::error_code ec;auto parsed=boost::json::parse(*value,ec);restoring=!ec && parsed.is_object() && parsed.as_object().if_contains("nonce") && parsed.as_object().at("nonce").is_string() && parsed.as_object().at("nonce").as_string()==nonce;}}
+  if(*exists && !restoring)return {};
+  if(!*backed)return std::unexpected("Previous application backup is missing");
+  if(old.parent_path()==root)return move_tree(backup,old);
+  // A reset while copying back must retry the whole copy, not accept a partial
+  // destination merely because its directory now exists.
+  auto noted=Storage::fs_write_text(restore_marker().generic_string(),boost::json::serialize(boost::json::object{{"nonce",nonce}}),timeout);if(!noted)return noted;
+  auto cleared=erase_tree(old);if(!cleared)return cleared;
+  auto copied=copy_tree(backup,old);if(!copied)return copied;
+  return verify_copy(backup,old);
+ }
+};
+inline bool safe_id(const std::string &id){return !id.empty()&&id!="."&&id!=".."&&id.find('/')==std::string::npos&&id.find('\\')==std::string::npos;}
+inline std::expected<void,std::string> recover_root(const fs::path &root,const std::vector<fs::path> &roots,const std::string &system_type){
+ auto e=present(root/".transactions");if(!e)return std::unexpected(e.error());if(!*e)return {};
+ auto list=Storage::fs_list((root/".transactions").generic_string(),timeout);if(!list)return std::unexpected(list.error());
+ for(const auto &file:*list){
+  if(file.info.type!=Storage::FileType::File||fs::path(file.name).extension()!=".json")continue;
+  auto text=Storage::fs_read_text((root/".transactions"/file.name).generic_string(),timeout);if(!text)return std::unexpected(text.error());
+  boost::system::error_code ec;auto parsed=boost::json::parse(*text,ec);if(ec||!parsed.is_object())continue;
+  auto &o=parsed.as_object();auto string=[&](const char *key){auto *v=o.if_contains(key);return v&&v->is_string()?std::string(v->as_string()):std::string();};
+  Transaction t{string("id"),string("nonce"),root,fs::path(string("old")).lexically_normal(),fs::path(string("final")).lexically_normal(),fs::path(string("backup")).lexically_normal(),fs::path(string("stage")).lexically_normal()};
+  if(!safe_id(t.id)||t.nonce.empty()||file.name!=t.id+".json"||t.final!=root/t.id||t.backup!=root/".rollback"/t.id||t.stage.parent_path()!=root/".installing"||!t.stage.filename().generic_string().starts_with(t.id+"-"))continue;
+  bool old_safe=t.old.empty();for(const auto &r:roots)old_safe=old_safe||t.old==r/t.id;
+  if(!old_safe)continue;
+  if(!t.old.empty()&&t.old.parent_path()!=root&&!requires_sd(t.id))continue;
+  if(brookesia_child_requires_internal&&brookesia_child_requires_internal(t.id.c_str())&&root.generic_string().starts_with("/sdcard"))continue;
+  bool committed=false;auto done=present(t.commit_marker());if(!done)return std::unexpected(done.error());
+  if(*done){auto value=Storage::fs_read_text(t.commit_marker().generic_string(),timeout);if(value){auto d=boost::json::parse(*value,ec);committed=!ec&&d.is_object()&&d.as_object().if_contains("nonce")&&d.as_object().at("nonce").is_string()&&d.as_object().at("nonce").as_string()==t.nonce;}}
+  if(committed){auto manifest=read_unpacked_app_manifest(t.final.generic_string(),system_type);committed=manifest&&manifest->id==t.id;}
+  std::expected<void,std::string> result;
+  if(committed){if(!t.old.empty()&&t.old!=t.final)result=erase_tree(t.old);}
+  else result=t.rollback();
+  if(!result)return result;
+  result=erase_tree(t.stage);if(!result)return result;
+  result=t.clear();if(!result)return result;
+ }
+ return {};
+}
