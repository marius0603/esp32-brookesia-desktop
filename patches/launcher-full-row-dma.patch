+bool LcdDisplayPanelImpl::can_widen_desktop_draw(
+    uint32_t x1, uint32_t y1, uint32_t x2, uint32_t y2
+) const
+{
+    if (!desktop_margins_ || !brookesia_board_desktop_visible() ||
+            x1 > DESKTOP_MARGIN_WIDTH || x2 < DESKTOP_RIGHT_EDGE || (x1 == 0 && x2 == DESKTOP_PANEL_SIZE) ||
+            y2 - y1 < DESKTOP_PANEL_SIZE / 2) {
+        return false;
+    }
+
+    for (auto y = y1; y < y2; ++y) {
+        if ((x1 > 0 && !desktop_left_valid_.test(y)) ||
+                (x2 < DESKTOP_PANEL_SIZE && !desktop_right_valid_.test(y))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void LcdDisplayPanelImpl::cache_desktop_margins(
+    uint32_t x1, uint32_t y1, uint32_t x2, uint32_t y2, const uint8_t *data
+)
+{
+    const auto left_end = std::min(x2, DESKTOP_MARGIN_WIDTH);
+    const auto right_start = std::max(x1, DESKTOP_RIGHT_EDGE);
+    const auto input_row_bytes = size_t(x2 - x1) * 2;
+
+    for (auto y = y1; y < y2; ++y) {
+        const auto *src = data + size_t(y - y1) * input_row_bytes;
+        const auto margin_offset = size_t(y) * DESKTOP_MARGIN_ROW_BYTES;
+        if (x1 < left_end) {
+            memcpy(desktop_margins_ + margin_offset + x1 * 2, src, (left_end - x1) * 2);
+            if (x1 == 0 && left_end == DESKTOP_MARGIN_WIDTH) desktop_left_valid_.set(y);
+        }
+        if (right_start < x2) {
+            memcpy(
+                desktop_margins_ + DESKTOP_MARGIN_BYTES + margin_offset + (right_start - DESKTOP_RIGHT_EDGE) * 2,
+                src + (right_start - x1) * 2, (x2 - right_start) * 2
+            );
+            if (right_start == DESKTOP_RIGHT_EDGE && x2 == DESKTOP_PANEL_SIZE) desktop_right_valid_.set(y);
+        }
+    }
+}
