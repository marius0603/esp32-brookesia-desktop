+std::expected<void, std::string> Runtime::set_app_palette(
+    DocumentId id, std::map<std::string, std::string> colors
+)
+{
+    auto *tree = impl_->resolve_tree(id);
+    if (!tree) return std::unexpected("GUI document not loaded");
+    if (tree->use_app_palette && tree->color_overrides == colors) return {};
+    tree->use_app_palette = true;
+    tree->color_overrides = std::move(colors);
+    tree->definition_style_cache.clear();
+    tree->resolved_style_intern_cache.clear();
+    return reapply_styles(id);
+}
+
 std::expected<void, std::string> Runtime::reapply_styles(DocumentId id)
 {
     return impl_->reapply_styles(id);
