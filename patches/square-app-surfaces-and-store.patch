@@ -0,0 +1,28 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+
+namespace esp_brookesia::system::core {
+
+struct SquareDesktopPalette {
+    const char *background;
+    const char *tile;
+    const char *edge;
+    const char *weather;
+    const char *controls;
+    const char *muted;
+    const char *accent;
+};
+
+inline const SquareDesktopPalette &square_desktop_palette(int selected)
+{
+    static constexpr std::array<SquareDesktopPalette, 4> palettes = {{
+        {"#101714", "#1B271F", "#304036", "#273721", "#1D2922", "#A7B2A9", "#D5F588"},
+        {"#0D1521", "#17293D", "#2B4560", "#203B53", "#1A2D43", "#A5B9CB", "#A3E6F3"},
+        {"#191321", "#2B203A", "#48375A", "#372649", "#31233F", "#BDAECB", "#DAC4FA"},
+        {"#201611", "#33241A", "#573C2D", "#492E1D", "#38261A", "#C7B2A5", "#F2CD92"},
+    }};
+    return palettes[std::clamp(selected - 2, 0, 3)];
+}
+}
