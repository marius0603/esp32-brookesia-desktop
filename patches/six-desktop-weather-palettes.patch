+// Mix an in-family surface, matching the approved weather preview percentages.
+std::string weather_surface(const SquareDesktopPalette &palette, unsigned per_mille)
+{
+    const auto base = std::strtoul(palette.background + 1, nullptr, 16);
+    const auto ink = std::strtoul(palette.text + 1, nullptr, 16);
+    unsigned rgb = 0;
+    for (const int shift : {16, 8, 0}) {
+        const auto b = (base >> shift) & 0xff;
+        const auto f = (ink >> shift) & 0xff;
+        rgb |= static_cast<unsigned>(((1000 - per_mille) * b + per_mille * f + 500) / 1000) << shift;
+    }
+    char color[8];
+    std::snprintf(color, sizeof(color), "#%06X", rgb);
+    return color;
+}
 
