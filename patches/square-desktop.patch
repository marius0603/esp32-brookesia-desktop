diff --git a/system/brookesia_system_super/src/shell_status.cpp b/system/brookesia_system_super/src/shell_status.cpp
index d0c4d84..a4f29bc 100644
--- a/system/brookesia_system_super/src/shell_status.cpp
+++ b/system/brookesia_system_super/src/shell_status.cpp
@@ -23,6 +23,10 @@
 
 extern "C" bool brookesia_board_screen_asleep() __attribute__((weak));
 
+#include <cmath>
+#include "boost/json.hpp"
+#include "brookesia/service_helper/system/storage.hpp"
+
 namespace esp_brookesia::system::super {
 namespace {
 
@@ -262,7 +266,47 @@ void ShellApp::refresh_status_clock()
     if (context_ == nullptr) {
         return;
     }
-    auto result = context_->gui().set_binding_value(SUPER_STATUS_CLOCK_PATH, "clock_text", make_clock_text());
+    const auto clock_text = make_clock_text();
+    auto result = context_->gui().set_binding_value(SUPER_STATUS_CLOCK_PATH, "clock_text", clock_text);
+    constexpr auto header = "/launcher/content/square_header";
+    if (foreground_is_shell_ && launcher_populated_ && context_->gui().get_view_frame(header)) {
+        std::string city = "天气";
+        std::string temperature = "--";
+        const auto state = service::helper::Storage::fs_read_text("/littlefs/weather-state.json", 500);
+        if (state) {
+            boost::system::error_code error;
+            const auto json = boost::json::parse(*state, error);
+            if (!error && json.is_object()) {
+                const auto &object = json.as_object();
+                if (const auto *value = object.if_contains("temperature"); value && value->is_number()) {
+                    temperature = std::to_string(static_cast<int>(std::lround(value->to_number<double>()))) + "°";
+                }
+                const auto *location = object.if_contains("location");
+                if (location && location->is_object()) {
+                    const auto *text = location->as_object().if_contains("city");
+                    if (text && text->is_string() && text->as_string().size() <= 36) {
+                        city.assign(text->as_string().data(), text->as_string().size());
+                    }
+                }
+            }
+        }
+        const auto now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+        std::tm local{};
+#if defined(_WIN32)
+        localtime_s(&local, &now);
+#else
+        localtime_r(&now, &local);
+#endif
+        static constexpr const char *weekdays[] = {"日", "一", "二", "三", "四", "五", "六"};
+        const auto date = std::to_string(local.tm_mon + 1) + "月" +
+                          std::to_string(local.tm_mday) + "日  周" + weekdays[local.tm_wday];
+        (void)context_->gui().set_binding_values({
+            {"/launcher/content/square_header/time", "text", clock_text},
+            {"/launcher/content/square_header/date", "text", date},
+            {"/launcher/content/square_header/weather/temperature", "text", temperature},
+            {"/launcher/content/square_header/weather/city", "text", city}
+        });
+    }
     if (!result) {
         BROOKESIA_LOGW("Failed to refresh Shell status clock: %1%", result.error());
     }
