+std::string ShellApp::launcher_icon_source(const core::AppManifest &manifest, int theme)
+{
+    constexpr std::array<std::string_view, 15> square_icons = {
+        "brookesia.general.app_store", "brookesia.general.files", "brookesia.general.settings",
+        "local.childmode", "local.audiobook", "local.codex.quota", "local.flipclock",
+        "local.gravitymaze", "local.lightlearning", "local.navigation", "local.nurserysongs",
+        "local.radio", "local.virtualpet", "local.voiceassistant", "local.weather",
+    };
+    if (theme >= 2 && std::find(square_icons.begin(), square_icons.end(), manifest.id) != square_icons.end()) {
+        return "square." + manifest.id;
+    }
+    return theme == 1 ? "cyber." + manifest.id : core::resolve_app_icon_resource_id(manifest);
+}
