+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace esp_brookesia::system::super {
+
+class LauncherSwipe {
+public:
+    constexpr void begin()
+    {
+        *this = {};
+        active_ = true;
+    }
+
+    constexpr void update(float dx, float dy, uint32_t time_ms)
+    {
+        if (!active_ || time_ms <= last_sample_ms_) {
+            return;
+        }
+
+        const auto elapsed_ms = time_ms - last_sample_ms_;
+        if (elapsed_ms <= max_sample_gap_ms) {
+            const float speed = (dx - last_dx_) / elapsed_ms;
+            // Follow reversals immediately and decay while the finger is still.
+            velocity_ = speed * velocity_ < 0 ? speed : (velocity_ + speed) * 0.5F;
+        } else {
+            velocity_ = 0;
+        }
+        last_dx_ = dx;
+        last_sample_ms_ = time_ms;
+        dragging_ = dragging_ || (magnitude(dx) > 8 && magnitude(dx) > magnitude(dy));
+    }
+
+    constexpr bool dragging() const
+    {
+        return dragging_;
+    }
+
+    constexpr int page_delta(float dx, int32_t page_width, uint32_t release_ms) const
+    {
+        if (magnitude(dx) < min_distance) {
+            return 0;
+        }
+
+        const float threshold = std::max(page_width * 0.25F, 24.0F);
+        const float max_projection = threshold - min_distance;
+        // Release includes the debounce interval. Only project movement
+        // measured while touching and discard velocity across long gaps.
+        const bool recent = release_ms - last_sample_ms_ <= max_release_gap_ms;
+        const float projection = recent && magnitude(velocity_) >= 0.12F ?
+                                 std::clamp(velocity_ * 120.0F, -max_projection, max_projection) : 0;
+        const float projected = dx + projection;
+        if (dx < 0 && projected <= -threshold) {
+            return 1;
+        }
+        if (dx > 0 && projected >= threshold) {
+            return -1;
+        }
+        return 0;
+    }
+
+private:
+    static constexpr float min_distance = 12;
+    static constexpr uint32_t max_sample_gap_ms = 65;
+    static constexpr uint32_t max_release_gap_ms = 100;
+
+    static constexpr float magnitude(float value)
+    {
+        return value < 0 ? -value : value;
+    }
+
+    float last_dx_ = 0;
+    float velocity_ = 0;
+    uint32_t last_sample_ms_ = 0;
+    bool active_ = false;
+    bool dragging_ = false;
+};
+
+} // namespace esp_brookesia::system::super
