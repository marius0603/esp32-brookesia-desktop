     std::expected<void, std::string> submit_wifi_connect(system::core::AppContext &context);
     void cancel_wifi_keyboard_if_active(system::core::AppContext &context);
 
+    // Service callbacks run independently of the native app worker. A mailbox
+    // belongs to a single opening of Controls and carries no app pointer.
+    struct UiMailbox {
+        std::mutex mutex;
+        std::vector<std::function<void()>> pending;
+    };
+
+    template<typename Callback>
+    auto defer_service_ui(Callback callback)
+    {
+        std::weak_ptr<UiMailbox> mailbox = ui_mailbox_;
+        return [mailbox, callback = std::move(callback)](auto &&...args) {
+            if (auto target = mailbox.lock()) {
+                auto payload = std::make_tuple(std::forward<decltype(args)>(args)...);
+                std::lock_guard lock(target->mutex);
+                target->pending.emplace_back([callback, payload = std::move(payload)]() mutable {
+                    std::apply(callback, std::move(payload));
+                });
+            }
+        };
+    }
+
+    std::shared_ptr<UiMailbox> ui_mailbox_;
+    system::core::TimerId ui_mailbox_timer_ = system::core::INVALID_TIMER_ID;
     struct Impl;
     std::unique_ptr<Impl> impl_;
 };
