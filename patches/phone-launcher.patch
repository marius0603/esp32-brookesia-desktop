+void ShellApp::set_launcher_page(size_t page, bool animate)
+{
+    if (!context_) return;
+    launcher_page_ = std::min(page, launcher_pages_ - 1);
+    const int32_t target = static_cast<int32_t>(launcher_page_) * launcher_page_width_;
+    std::vector<gui::BindingValueUpdate> updates;
+    std::string dots;
+    for (size_t i = 0; i < launcher_pages_; ++i) { if (i) dots += "  "; dots += i == launcher_page_ ? "●" : "○"; }
+    add_binding_update(updates, "/launcher/content/pages", "text", dots);
+    (void)context_->gui().set_binding_values(updates);
+    // Native LVGL drag owns movement; only snap once on release.
+    (void)context_->gui().scroll_to(SUPER_LAUNCHER_GRID_STAGE_PATH, target, 0, animate);
+}
+
+void ShellApp::handle_launcher_swipe(const service::Display::TouchGestureInfo &info)
+{
+    using Type = service::Display::TouchGestureEventType;
+    if (launch_overlay_active_ || !launcher_populated_ || !system_ui_expanded_) return;
+    if (info.event_type == Type::Press) { launcher_swiping_ = false; return; }
+    const float density = std::max(owner_.get_environment().density, .001F);
+    int32_t dx = static_cast<int32_t>((info.stop_x - info.start_x) / density);
+    const int32_t dy = static_cast<int32_t>((info.stop_y - info.start_y) / density);
+    if (std::abs(dx) > 8 && std::abs(dx) > std::abs(dy) * 1.3F) launcher_swiping_ = true;
+    if (!launcher_swiping_) return;
+    launcher_click_after_ = SteadyClock::now() + std::chrono::milliseconds(300);
+    if (info.event_type == Type::Release) {
+        size_t next = launcher_page_;
+        const int32_t threshold = info.duration_ms <= 350 ? 12 : 24;
+        if (dx <= -threshold && next + 1 < launcher_pages_) ++next;
+        if (dx >= threshold && next > 0) --next;
+        launcher_swiping_ = false;
+        set_launcher_page(next, true);
+        return;
+    }
+    // No binding updates while moving: LVGL scrolls in its input/render loop.
+
+}
