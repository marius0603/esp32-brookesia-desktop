+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace esp_brookesia::system::super {
+
+class AppBackSwipe {
+public:
+    static constexpr int32_t edge_height(int32_t screen_height)
+    {
+        return std::clamp<int32_t>(screen_height / 20, 12, 32);
+    }
+
+    constexpr void begin(bool at_bottom_edge)
+    {
+        *this = {};
+        candidate_ = at_bottom_edge;
+    }
+
+    constexpr bool update(int32_t sideways, int32_t upward, uint32_t time_ms)
+    {
+        if (!candidate_ || time_ms <= last_sample_ms_) {
+            return claimed_;
+        }
+
+        const int32_t horizontal = sideways < 0 ? -sideways : sideways;
+        if (!claimed_) {
+            if (horizontal >= 12 && horizontal >= upward) {
+                candidate_ = false;
+                return false;
+            }
+            claimed_ = upward >= 12 && upward * 4 >= horizontal * 5;
+        }
+
+        const auto elapsed_ms = time_ms - last_sample_ms_;
+        const float speed = elapsed_ms <= 65 ? static_cast<float>(upward - last_upward_) / elapsed_ms : 0;
+        velocity_ = elapsed_ms > 65 || speed * velocity_ < 0 ? speed : (speed + velocity_) * 0.5F;
+        last_sample_ms_ = time_ms;
+        last_upward_ = upward;
+        return claimed_;
+    }
+
+    constexpr bool should_return(int32_t upward, int32_t exit_distance, uint32_t release_ms) const
+    {
+        if (!claimed_ || upward < 18) {
+            return false;
+        }
+
+        // Release carries the last contact position and includes the service debounce.
+        const float speed = release_ms - last_sample_ms_ <= 100 ? velocity_ : 0;
+        if (speed <= -0.7F) {
+            return false;
+        }
+        return upward >= exit_distance || speed >= 0.7F;
+    }
+
+private:
+    uint32_t last_sample_ms_ = 0;
+    int32_t last_upward_ = 0;
+    float velocity_ = 0;
+    bool candidate_ = false;
+    bool claimed_ = false;
+};
+
+} // namespace esp_brookesia::system::super
