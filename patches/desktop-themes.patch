+void ShellApp::refresh_desktop_theme(bool force)
+{
+    if(!context_ || !launcher_populated_)return;
+    const int selected=brookesia_board_desktop_theme?brookesia_board_desktop_theme():0;
+    if(!force && selected==desktop_theme_applied_)return;
+    std::vector<gui::BindingValueUpdate> updates;
+    for(const auto &app:owner_.list_apps()) {
+        if(!app.manifest.visible || !core::has_app_icon_image(app.manifest))continue;
+        const auto path=make_launcher_item_path(app.app_id);
+        const auto source=selected==1?"cyber."+app.manifest.id:core::resolve_app_icon_resource_id(app.manifest);
+        add_binding_update(updates,path+"/"+SUPER_LAUNCHER_IMAGE_ICON_ID,"src",source);
+        add_binding_update(updates,path+"/"+SUPER_LAUNCHER_LABEL_ID,"theme_text",selected==1?"#edf5ff":"#664c40");
+    }
+    add_binding_update(updates,"/launcher/content/pages","theme_text",selected==1?"#65edff":"#775145");
+    auto result=context_->gui().set_binding_values(updates);
+    if(!result){BROOKESIA_LOGW("Desktop theme icons failed: %1%",result.error());return;}
+    auto wallpaper=context_->gui().set_view_src("/background/cream_wallpaper",selected==1?"cyber.wallpaper":"cream.wallpaper");
+    if(!wallpaper){BROOKESIA_LOGW("Desktop wallpaper failed: %1%",wallpaper.error());return;}
+    desktop_theme_applied_=selected;
+    if(brookesia_board_desktop_theme_applied)brookesia_board_desktop_theme_applied(selected);
+    BROOKESIA_LOGI("Desktop theme applied: %1%",selected==1?"cyberpunk-v1":"cartoon-q-v1");
 }
 
