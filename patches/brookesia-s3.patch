+void ShellApp::refresh_wallpaper_shift()
+{
+    if (context_ == nullptr) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    constexpr auto interval = std::chrono::seconds(60);
+    // Reuse the status timer; only visible, awake desktop time advances motion.
+    if (!foreground_is_shell_ || !system_ui_expanded_ ||
+            (brookesia_board_screen_asleep && brookesia_board_screen_asleep())) {
+        wallpaper_next_shift_ = now + interval;
+        return;
+    }
+    if (!wallpaper_next_shift_) {
+        wallpaper_next_shift_ = now + interval;
+        return;
+    }
+    if (now < *wallpaper_next_shift_) {
+        return;
+    }
+    wallpaper_next_shift_ = now + interval;
+    constexpr const char *path = "/background/cream_wallpaper";
+    const auto frame = context_->gui().get_view_frame(path);
+    // Only move an opted-in, oversized wallpaper. Legacy/custom backgrounds
+    // without the safe margin remain untouched and never expose blank edges.
+    if (!frame || frame->width != 486 || frame->height != 486) {
+        return;
+    }
+    static constexpr int offsets[][2] = {
+        {0, 0}, {3, 0}, {3, 3}, {0, 3}, {-3, 3},
+        {-3, 0}, {-3, -3}, {0, -3}, {3, -3}
+    };
+    const unsigned next = (wallpaper_shift_step_ + 1) % 9;
+    const auto result = context_->gui().set_binding_values({
+        {.absolute_path = path, .key = "wallpaper_x", .value = std::to_string(-3 + offsets[next][0])},
+        {.absolute_path = path, .key = "wallpaper_y", .value = std::to_string(-3 + offsets[next][1])},
+    });
+    if (result) {
+        wallpaper_shift_step_ = next;
+    } else {
+        BROOKESIA_LOGW("Wallpaper shift skipped: %1%", result.error());
+    }
+}
