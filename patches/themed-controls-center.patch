+std::expected<void, std::string> AppGuiRuntime::set_document_palette(std::string_view constant_path) const
+{
+    if (!system_) return std::unexpected("System is not available");
+    auto &impl = *system_->impl_;
+    return impl.run_task_sync<std::expected<void, std::string>>(
+        SYSTEM_GUI_TASK_GROUP,
+        [&impl, app_id = app_id_, path = std::string(constant_path)]() -> std::expected<void, std::string> {
+            auto record = impl.get_record(app_id);
+            if (!record || !impl.gui_runtime_ || !(*record)->document_id) {
+                return std::unexpected("App GUI document is not loaded");
+            }
+            return impl.gui_runtime_->set_document_palette(*(*record)->document_id, path);
+        },
+        std::unexpected("Failed to post GUI palette update")
+    );
+}
