+void SettingsApp::refresh_controls_palette(system::core::AppContext &context)
+{
+    if (!impl_->square_controls_ui) return;
+    constexpr std::array<std::string_view, 6> palettes = {
+        "controls.palettes.classic", "controls.palettes.cyber", "controls.palettes.moss",
+        "controls.palettes.ocean", "controls.palettes.violet", "controls.palettes.brown",
+    };
+    const int selected = brookesia_board_desktop_theme ? brookesia_board_desktop_theme() : 2;
+    const int index = selected >= 0 && selected < static_cast<int>(palettes.size()) ? selected : 2;
+    if (impl_->controls_palette_index == index) return;
+    if (auto result = context.gui().set_document_palette(palettes[index]); result) {
+        impl_->controls_palette_index = index;
+    } else {
+        BROOKESIA_LOGW("Could not apply Controls palette: %1%", result.error());
+    }
+}
+
+void SettingsApp::show_controls_lock_prompt(system::core::AppContext &context)
+{
+    if (!impl_->square_controls_ui || !brookesia_board_lock_touch || impl_->controls_lock_prompt_open) return;
+    impl_->controls_lock_prompt_open = true;
+    (void)context.gui().set_binding_value("/settings_header/lock_dialog", "hidden", "false");
+}
+
+void SettingsApp::close_controls_lock_prompt(system::core::AppContext &context)
+{
+    if (!impl_->controls_lock_prompt_open) return;
+    impl_->controls_lock_prompt_open = false;
+    (void)context.gui().set_binding_value("/settings_header/lock_dialog", "hidden", "true");
+}
