+std::expected<void, std::string> Runtime::set_document_palette(DocumentId id, std::string_view constant_path)
+{
+    auto *tree = impl_->resolve_tree(id);
+    if (!tree) return std::unexpected("GUI document not loaded");
+    auto value = impl_->get_constant_value(id, constant_path);
+    if (!value) return std::unexpected(value.error());
+    const auto *colors = value->if_object();
+    if (!colors) return std::unexpected("Palette constant must be a color map");
+    std::map<std::string, std::string> overrides;
+    for (const auto &item : *colors) {
+        const auto *color = item.value().if_string();
+        if (!color || color->size() != 7 || (*color)[0] != '#' ||
+                std::string_view(color->data() + 1, 6).find_first_not_of("0123456789abcdefABCDEF") != std::string_view::npos) {
+            return std::unexpected("Palette colors must use #RRGGBB");
+        }
+        overrides.emplace(std::string(item.key()), std::string(*color));
+    }
+    if (tree->color_overrides == overrides) return {};
+    tree->color_overrides = std::move(overrides);
+    tree->definition_style_cache.clear();
+    tree->resolved_style_intern_cache.clear();
+    return reapply_styles(id);
+}
