{
  "type": "viewScreen",
  "id": "main",
  "commonProps": {
    "scrollable": false
  },
  "style": {
    "bgColor": "#0c1222",
    "padding": 12
  },
  "layout": {
    "type": "flex",
    "flexFlow": "column",
    "mainAlign": "center",
    "crossAlign": "center",
    "gap": 8
  },
  "children": [
    {
      "type": "label",
      "id": "chapter",
      "placement": {
        "width": 380,
        "height": 36
      },
      "style": {
        "textColor": "#e9ebfa",
        "font": "${font.audiobook_title}",
        "fontSize": 26,
        "textAlign": "center"
      },
      "labelProps": {
        "text": "装卡后扫描章节"
      }
    },
    {
      "type": "label",
      "id": "progress",
      "placement": {
        "width": 380,
        "height": 20
      },
      "style": {
        "textColor": "#e9ebfa",
        "font": "${font.zh_CN}",
        "fontSize": 18,
        "textAlign": "center"
      },
      "labelProps": {
        "text": "0:00:00"
      }
    },
    {
      "type": "label",
      "id": "status",
      "placement": {
        "width": 380,
        "height": 20
      },
      "style": {
        "textColor": "#bbc6e0",
        "font": "${font.zh_CN}",
        "fontSize": 18,
        "textAlign": "center"
      },
      "labelProps": {
        "text": "准备播放器"
      }
    },
    {
      "type": "container",
      "id": "transport",
      "placement": {
        "width": 380,
        "height": 56
      },
      "commonProps": {
        "scrollable": false
      },
      "style": {
        "bgOpacity": 0,
        "padding": 0,
        "borderWidth": 0
      },
      "layout": {
        "type": "flex",
        "flexFlow": "row",
        "mainAlign": "spaceBetween",
        "crossAlign": "center"
      },
      "children": [
        {
          "type": "button",
          "id": "previous",
          "placement": {
            "width": 120,
            "height": 56
          },
          "style": {
            "bgColor": "#263756",
            "radius": 16,
            "padding": 0
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "previous"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "label",
              "style": {
                "font": "${font.zh_CN}",
                "fontSize": 24,
                "textColor": "#ffffff"
              },
              "labelProps": {
                "text": "上一章"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "toggle",
          "placement": {
            "width": 128,
            "height": 56
          },
          "style": {
            "bgColor": "#263756",
            "radius": 16,
            "padding": 0
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "toggle"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "label",
              "style": {
                "font": "${font.zh_CN}",
                "fontSize": 24,
                "textColor": "#ffffff"
              },
              "labelProps": {
                "text": "播放"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "next",
          "placement": {
            "width": 120,
            "height": 56
          },
          "style": {
            "bgColor": "#263756",
            "radius": 16,
            "padding": 0
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "next"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "label",
              "style": {
                "font": "${font.zh_CN}",
                "fontSize": 24,
                "textColor": "#ffffff"
              },
              "labelProps": {
                "text": "下一章"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "id": "sleep",
      "placement": {
        "width": 380,
        "height": 48
      },
      "commonProps": {
        "scrollable": false
      },
      "style": {
        "bgOpacity": 0,
        "padding": 0,
        "borderWidth": 0
      },
      "layout": {
        "type": "flex",
        "flexFlow": "row",
        "mainAlign": "spaceBetween",
        "crossAlign": "center"
      },
      "children": [
        {
          "type": "label",
          "id": "label",
          "placement": {
            "width": 120,
            "height": 32
          },
          "style": {
            "font": "${font.zh_CN}",
            "fontSize": 22,
            "textColor": "#cdd6ee"
          },
          "labelProps": {
            "text": "睡眠定时"
          }
        },
        {
          "type": "dropdown",
          "id": "choice",
          "placement": {
            "width": 248,
            "height": 48
          },
          "style": {
            "font": "${font.zh_CN}",
            "fontSize": 24,
            "bgColor": "#344166",
            "textColor": "#ffffff",
            "radius": 12,
            "padding": 6
          },
          "dropdownProps": {
            "options": [
              "关闭",
              "15分钟",
              "30分钟",
              "45分钟"
            ],
            "selectedIndex": 0
          },
          "bindings": {
            "dropdownProps.selectedIndex": "selected"
          },
          "events": [
            {
              "type": "valueChanged",
              "action": "sleepChoice"
            }
          ]
        }
      ]
    },
    {
      "type": "label",
      "id": "sleepStatus",
      "placement": {
        "width": 380,
        "height": 20
      },
      "style": {
        "font": "${font.zh_CN}",
        "fontSize": 18,
        "textColor": "#cdd6ee",
        "textAlign": "center"
      },
      "labelProps": {
        "text": "睡眠定时 · 最后两分钟渐弱"
      }
    },
    {
      "type": "label",
      "id": "volume",
      "placement": {
        "width": 380,
        "height": 20
      },
      "style": {
        "textColor": "#e9ebfa",
        "font": "${font.zh_CN}",
        "fontSize": 18,
        "textAlign": "center"
      },
      "labelProps": {
        "text": "音量 --% · 两侧实体键调节"
      }
    },
    {
      "type": "container",
      "id": "tools",
      "placement": {
        "width": 380,
        "height": 52
      },
      "commonProps": {
        "scrollable": false
      },
      "style": {
        "bgOpacity": 0,
        "borderWidth": 0,
        "padding": 0
      },
      "layout": {
        "type": "flex",
        "flexFlow": "row",
        "mainAlign": "spaceBetween",
        "crossAlign": "center"
      },
      "children": [
        {
          "type": "button",
          "id": "voice",
          "placement": {
            "width": 248,
            "height": 52
          },
          "style": {
            "bgColor": "#263756",
            "radius": 16,
            "padding": 0
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "offlineSpeak"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "label",
              "style": {
                "font": "${font.zh_CN}",
                "fontSize": 22,
                "textColor": "#ffffff"
              },
              "labelProps": {
                "text": "点一下说话 · 离线"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "lock",
          "placement": {
            "width": 124,
            "height": 52
          },
          "style": {
            "bgColor": "#344166",
            "radius": 14,
            "padding": 0
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "lockScreen"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "label",
              "style": {
                "font": "${font.zh_CN}",
                "fontSize": 24,
                "textColor": "#ffffff"
              },
              "labelProps": {
                "text": "锁屏"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "label",
      "id": "lockHint",
      "placement": {
        "width": 380,
        "height": 18
      },
      "style": {
        "font": "${font.zh_CN}",
        "fontSize": 17,
        "textColor": "#bbc6e0",
        "textAlign": "center"
      },
      "labelProps": {
        "text": "解锁：连按两次音量+"
      }
    }
  ]
}
