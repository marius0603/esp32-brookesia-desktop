{
  "type": "viewScreen",
  "id": "main",
  "commonProps": {
    "scrollable": false
  },
  "style": {
    "bgColor": "#080c14",
    "padding": 12,
    "borderWidth": 0
  },
  "layout": {
    "type": "flex",
    "flexFlow": "column",
    "mainAlign": "center",
    "crossAlign": "center",
    "gap": 10
  },
  "children": [
    {
      "type": "container",
      "id": "header",
      "commonProps": {
        "scrollable": false,
        "clickable": false
      },
      "placement": {
        "width": 400,
        "height": 48
      },
      "style": {
        "bgColor": "#101723",
        "borderColor": "#263347",
        "borderWidth": 0,
        "radius": 18,
        "padding": 0,
        "bgOpacity": 0
      },
      "children": [
        {
          "type": "label",
          "id": "volume",
          "placement": {
            "width": 250,
            "height": 36
          },
          "style": {
            "font": "${font.zh_CN}",
            "fontSize": 24,
            "textColor": "#e7ebf3",
            "textAlign": "left"
          },
          "labelProps": {
            "text": "音量 --%"
          }
        },
        {
          "type": "button",
          "id": "lock",
          "placement": {
            "width": 124,
            "height": 48
          },
          "style": {
            "bgColor": "#202b3e",
            "radius": 16,
            "padding": 0,
            "borderWidth": 1,
            "borderColor": "#33415a"
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "lockScreen"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "label",
              "style": {
                "font": "${font.zh_CN}",
                "fontSize": 22,
                "textColor": "#ffffff"
              },
              "labelProps": {
                "text": "锁屏"
              }
            }
          ]
        }
      ],
      "layout": {
        "type": "flex",
        "flexFlow": "row",
        "mainAlign": "spaceBetween",
        "crossAlign": "center"
      }
    },
    {
      "type": "container",
      "id": "player",
      "commonProps": {
        "scrollable": false,
        "clickable": false
      },
      "placement": {
        "width": 400,
        "height": 132
      },
      "style": {
        "bgColor": "#101723",
        "borderColor": "#263347",
        "borderWidth": 1,
        "radius": 18,
        "padding": 0,
        "bgGradientColor": "#0c121e",
        "bgGradientDirection": "vertical"
      },
      "children": [
        {
          "type": "label",
          "id": "chapter",
          "placement": {
            "width": 364,
            "height": 46,
            "mode": "absolute",
            "x": 18,
            "y": 8
          },
          "style": {
            "font": "${font.audiobook_title}",
            "fontSize": 32,
            "textColor": "#f7e7bd",
            "textAlign": "center"
          },
          "labelProps": {
            "text": "暂无故事"
          }
        },
        {
          "type": "label",
          "id": "progress",
          "placement": {
            "width": 364,
            "height": 34,
            "mode": "absolute",
            "x": 18,
            "y": 58
          },
          "style": {
            "font": "${font.zh_CN}",
            "fontSize": 24,
            "textColor": "#e7ebf3",
            "textAlign": "center"
          },
          "labelProps": {
            "text": "0:00:00"
          }
        },
        {
          "type": "label",
          "id": "status",
          "placement": {
            "width": 364,
            "height": 28,
            "mode": "absolute",
            "x": 18,
            "y": 96
          },
          "style": {
            "font": "${font.zh_CN}",
            "fontSize": 20,
            "textColor": "#93a4bd",
            "textAlign": "center"
          },
          "labelProps": {
            "text": "未播放"
          }
        }
      ]
    },
    {
      "type": "container",
      "id": "transport",
      "placement": {
        "width": 400,
        "height": 60
      },
      "commonProps": {
        "scrollable": false
      },
      "style": {
        "bgOpacity": 0,
        "padding": 0,
        "borderWidth": 0
      },
      "layout": {
        "type": "flex",
        "flexFlow": "row",
        "mainAlign": "spaceBetween",
        "crossAlign": "center"
      },
      "children": [
        {
          "type": "button",
          "id": "previous",
          "placement": {
            "width": 112,
            "height": 60
          },
          "style": {
            "bgColor": "#202c42",
            "radius": 20,
            "padding": 0,
            "borderWidth": 0
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "previous"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "label",
              "style": {
                "font": "${font.zh_CN}",
                "fontSize": 26,
                "textColor": "#ecf0f8"
              },
              "labelProps": {
                "text": "上一章"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "toggle",
          "placement": {
            "width": 152,
            "height": 60
          },
          "style": {
            "bgColor": "#f2d38b",
            "radius": 20,
            "padding": 0,
            "borderWidth": 0
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "toggle"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "label",
              "style": {
                "font": "${font.zh_CN}",
                "fontSize": 26,
                "textColor": "#211b10"
              },
              "labelProps": {
                "text": "播放"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "next",
          "placement": {
            "width": 112,
            "height": 60
          },
          "style": {
            "bgColor": "#202c42",
            "radius": 20,
            "padding": 0,
            "borderWidth": 0
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "next"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "label",
              "style": {
                "font": "${font.zh_CN}",
                "fontSize": 26,
                "textColor": "#ecf0f8"
              },
              "labelProps": {
                "text": "下一章"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "container",
      "id": "sleep",
      "commonProps": {
        "scrollable": false,
        "clickable": false
      },
      "placement": {
        "width": 400,
        "height": 48
      },
      "style": {
        "bgColor": "#080c14",
        "borderColor": "#263347",
        "borderWidth": 0,
        "radius": 0,
        "padding": 0,
        "bgOpacity": 0
      },
      "children": [
        {
          "type": "label",
          "id": "label",
          "placement": {
            "width": 110,
            "height": 36,
            "mode": "absolute",
            "x": 0,
            "y": 8
          },
          "style": {
            "font": "${font.zh_CN}",
            "fontSize": 22,
            "textColor": "#cad4e4",
            "textAlign": "left"
          },
          "labelProps": {
            "text": "睡眠定时"
          }
        },
        {
          "type": "dropdown",
          "id": "choice",
          "placement": {
            "width": 172,
            "height": 48,
            "mode": "absolute",
            "x": 116,
            "y": 0
          },
          "style": {
            "font": "${font.zh_CN}",
            "fontSize": 22,
            "bgColor": "#202c42",
            "textColor": "#ffffff",
            "radius": 14,
            "padding": 6,
            "borderColor": "#33415a",
            "borderWidth": 1
          },
          "dropdownProps": {
            "options": [
              "关闭",
              "15分钟",
              "30分钟",
              "45分钟"
            ],
            "selectedIndex": 0
          },
          "bindings": {
            "dropdownProps.selectedIndex": "selected"
          },
          "events": [
            {
              "type": "valueChanged",
              "action": "sleepChoice"
            }
          ]
        },
        {
          "type": "label",
          "id": "sleepStatus",
          "placement": {
            "width": 100,
            "height": 30,
            "mode": "absolute",
            "x": 300,
            "y": 10
          },
          "style": {
            "font": "${font.zh_CN}",
            "fontSize": 22,
            "textColor": "#f2d38b",
            "textAlign": "right"
          },
          "labelProps": {
            "text": ""
          }
        }
      ]
    },
    {
      "type": "container",
      "id": "tools",
      "commonProps": {
        "scrollable": false,
        "clickable": false
      },
      "placement": {
        "width": 400,
        "height": 48
      },
      "style": {
        "bgColor": "#101723",
        "borderColor": "#263347",
        "borderWidth": 0,
        "radius": 18,
        "padding": 0,
        "bgOpacity": 0
      },
      "children": [
        {
          "type": "button",
          "id": "voice",
          "placement": {
            "width": 312,
            "height": 48
          },
          "style": {
            "bgColor": "#182235",
            "radius": 16,
            "padding": 0,
            "borderColor": "#2c3c55",
            "borderWidth": 1
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "offlineSpeak"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "label",
              "style": {
                "font": "${font.zh_CN}",
                "fontSize": 24,
                "textColor": "#dbe5f6"
              },
              "labelProps": {
                "text": "语音控制"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "mode",
          "placement": {
            "width": 72,
            "height": 48
          },
          "style": {
            "bgColor": "#182235",
            "radius": 16,
            "padding": 0,
            "borderColor": "#2c3c55",
            "borderWidth": 1
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "playMode"
            }
          ],
          "children": [
            {
              "type": "image",
              "id": "icon",
              "placement": {
                "width": 36,
                "height": 36
              },
              "commonProps": {
                "clickable": false
              },
              "imageProps": {
                "src": "${image.mode_sequence}"
              }
            }
          ]
        }
      ],
      "layout": {
        "type": "flex",
        "flexFlow": "row",
        "mainAlign": "spaceBetween",
        "crossAlign": "center"
      }
    }
  ]
}
