{
  "type": "viewScreen",
  "id": "main",
  "commonProps": {
    "scrollable": false
  },
  "style": {
    "bgColor": "#000000",
    "padding": 0
  },
  "children": [
    {
      "type": "image",
      "id": "crown",
      "placement": {
        "mode": "absolute",
        "x": 80,
        "y": 30,
        "width": 320,
        "height": 90
      },
      "commonProps": {
        "clickable": false,
        "scrollable": false
      },
      "bindings": {
        "placement.x": "x",
        "placement.y": "y"
      },
      "imageProps": {
        "src": "${image.crown}",
        "innerAlign": "center"
      }
    },
    {
      "type": "image",
      "id": "left",
      "placement": {
        "mode": "absolute",
        "x": 70,
        "y": 150,
        "width": 130,
        "height": 140
      },
      "commonProps": {
        "clickable": false,
        "scrollable": false
      },
      "bindings": {
        "placement.x": "x",
        "placement.y": "y"
      },
      "imageProps": {
        "src": "${image.eye_open}",
        "innerAlign": "center"
      }
    },
    {
      "type": "image",
      "id": "right",
      "placement": {
        "mode": "absolute",
        "x": 280,
        "y": 150,
        "width": 130,
        "height": 140
      },
      "commonProps": {
        "clickable": false,
        "scrollable": false
      },
      "bindings": {
        "placement.x": "x",
        "placement.y": "y"
      },
      "imageProps": {
        "src": "${image.eye_open}",
        "innerAlign": "center"
      }
    },
    {
      "type": "image",
      "id": "mouth",
      "placement": {
        "mode": "absolute",
        "x": 200,
        "y": 320,
        "width": 80,
        "height": 50
      },
      "commonProps": {
        "clickable": false,
        "scrollable": false
      },
      "bindings": {
        "placement.x": "x",
        "placement.y": "y"
      },
      "imageProps": {
        "src": "${image.mouth_idle}",
        "innerAlign": "center"
      }
    },
    {
      "type": "container",
      "id": "touch",
      "placement": {
        "mode": "absolute",
        "x": 0,
        "y": 0,
        "width": 480,
        "height": 440
      },
      "commonProps": {
        "clickable": true,
        "scrollable": false,
        "pressLock": true
      },
      "style": {
        "bgOpacity": 0,
        "padding": 0,
        "borderWidth": 0
      },
      "events": [
        {
          "type": "pressed",
          "action": "facePress"
        },
        {
          "type": "pressing",
          "action": "faceMove"
        },
        {
          "type": "released",
          "action": "faceRelease"
        },
        {
          "type": "pressLost",
          "action": "faceCancel"
        }
      ]
    }
  ]
}
